---
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Daniel Fang - Founder, Engineer, Investor",
  description = "Founder and engineer building thoughtful digital experiences. Showcasing creative projects, investment activity, and written content.",
  ogImage = "/og-default.svg",
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = title.includes("Daniel Fang")
  ? title
  : `${title} - Daniel Fang`;

// Cloudflare Web Analytics — privacy-first, cookieless. Token is set via the
// PUBLIC_CF_BEACON_TOKEN env var (in Netlify) so it stays out of source.
// Only loaded in production builds, so local dev/preview never pollutes stats.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const enableAnalytics = import.meta.env.PROD && Boolean(cfBeaconToken);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@danielfang" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Structured data: Person -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Daniel Fang",
        "url": "https://danielfang.me",
        "sameAs": [
          "https://github.com/danielfang7",
          "https://linkedin.com/in/danielfang7",
          "https://twitter.com/danielfang7"
        ],
        "jobTitle": "Founder, Engineer, Investor"
      }
    </script>

    <!-- Font connections — preconnect speeds up Google Fonts DNS + TLS -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Web manifest -->
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a0a0a" />

    <!-- Cloudflare Web Analytics — cookieless, no consent banner needed.
         SPA navigations (Astro ClientRouter pushState) are tracked automatically.
         ClientRouter de-dupes this script by src, so it loads once and the
         History API patch persists across view transitions (no double counts). -->
    {
      enableAnalytics && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }

    <!-- View Transitions (soft navigation + shared-element morphing) -->
    <ClientRouter />
  </head>

  <body>
    <!-- Skip to content for accessibility -->
    <a href="#main-content" class="skip-to-content">Skip to content</a>

    <Nav />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      import { initMagneticCTAs } from "@/scripts/magnetic-cta";
      import type { TransitionBeforeSwapEvent } from "astro:transitions/client";

      let _magneticPageLoad = false;
      document.addEventListener("astro:page-load", () => {
        _magneticPageLoad = true;
        initMagneticCTAs();
      });
      requestAnimationFrame(() => {
        if (!_magneticPageLoad) initMagneticCTAs();
      });

      // Scroll-reveal entrance elements render visible in the server HTML (so
      // they're shown without JS). On a view-transition navigation the GSAP
      // entrance re-runs and hides them *after* the new page has painted,
      // producing a visible→hidden flicker. We pre-hide the incoming page's
      // reveal targets (inline opacity, before paint) so the entrance only ever
      // plays once, from hidden. Inline style is used (not CSS) so GSAP's
      // clearProps on reveal returns elements to their visible default.
      const REVEAL_SELECTOR = [
        ".anim-fade-up",
        ".timeline-entry",
        ".investment-card",
        ".pillar-card",
        ".blog-post-item",
        ".works-grid-card",
        ".lab-grid-card",
        ".detail-fade-up",
        ".gallery-card",
      ].join(",");

      document.addEventListener("astro:before-swap", (event) => {
        const e = event as TransitionBeforeSwapEvent;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        e.newDocument
          .querySelectorAll<HTMLElement>(REVEAL_SELECTOR)
          .forEach((el) => {
            el.style.opacity = "0";
          });
      });
    </script>
  </body>
</html>
